# zk-prover-bench · jolt-atlas measurement harness
#
# OUR code. No jolt-atlas source is copied here. This is a separate Cargo workspace that
# depends on the pinned jolt-atlas clone through path dependencies and calls only its public
# API. jolt-atlas's LICENSE §2(i) grants the right to "download, install, and internally use
# the Software solely for the purpose of testing and evaluating it"; that is exactly and only
# what this harness does. Nothing here modifies, patches, instruments or redistributes it.
#
# The [patch.crates-io] block below is not a copy of jolt-atlas code: it is the dependency
# resolution the pinned tree requires (a16z's arkworks fork). Without it the path
# dependencies do not resolve to the same crates and the build is not the one under test.
[package]
name = "ja-harness"
version = "0.1.0"
edition = "2021"

[workspace]

[dependencies]
jolt-atlas-core = { path = "JA_ROOT/jolt-atlas-core" }
atlas-onnx-tracer = { path = "JA_ROOT/atlas-onnx-tracer" }
common = { path = "JA_ROOT/common" }
ark-serialize = { version = "0.5.0", default-features = false, features = ["derive"] }
rand = { version = "0.8.5", default-features = false }
serde_json = "1.0"

# Match the measured tree's release profile EXACTLY. jolt-atlas documents
# lto = "fat", overflow-checks = true, debug = 1 (its root Cargo.toml). A harness built with
# a different profile would measure a different binary; E-001 cost this project a 9.0x error
# and an inverted verdict for precisely this reason.
[profile.release]
debug = 1
overflow-checks = true
lto = "fat"

[patch.crates-io]
ark-ff = { git = "https://github.com/a16z/arkworks-algebra", branch = "dev/twist-shout" }
ark-ec = { git = "https://github.com/a16z/arkworks-algebra", branch = "dev/twist-shout" }
ark-serialize = { git = "https://github.com/a16z/arkworks-algebra", branch = "dev/twist-shout" }
ark-bn254 = { git = "https://github.com/a16z/arkworks-algebra", branch = "dev/twist-shout" }
allocative = { git = "https://github.com/facebookexperimental/allocative", rev = "85b773d85d526d068ce94724ff7a7b81203fc95e" }

# Pin the transitive git dependency to the SAME revision the measured tree resolves
# (read from jolt-atlas's own Cargo.lock at commit 434ab99). Without this a fresh workspace
# resolves tract HEAD, which raises the MSRV above the 1.88 toolchain jolt-atlas pins, and
# the harness would no longer be linking the code under test.
